# Copy this file to a private local .env only for Docker deployment.
# Never commit the resulting .env.
POSTGRES_DB=snowedge
POSTGRES_USER=snowedge
POSTGRES_PASSWORD=replace-with-a-long-random-password

# If the PostgreSQL password contains reserved URL characters, URL-encode it here.
DATABASE_URL=postgresql+psycopg://snowedge:replace-with-url-encoded-password@postgres:5432/snowedge

# Use a long random application secret and keep the same value on Web + Worker.
APP_SECRET_KEY=replace-with-a-long-random-app-secret

AI_PROVIDER=mock
