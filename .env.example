APP_NAME=SnowEdge
DATABASE_URL=sqlite:///./snowedge.db
AI_PROVIDER=mock
AI_API_BASE=
AI_API_KEY=
AI_MODEL=
AI_INCLUDE_RESPONSE_BODY=false
REQUEST_TIMEOUT_SECONDS=8
MAX_RESPONSE_BODY_BYTES=200000
MAX_PROJECT_TASKS=100
AUTHORIZATION_AUTO_CANDIDATE_FINDINGS=true
AUTHORIZATION_AUTO_CANDIDATE_MIN_CONFIDENCE=85

# Omit APP_SECRET_KEY for a unique persisted local installation secret.
# For shared Web/Worker deployment, explicitly configure the same random secret.
BROWSER_HEADLESS=true
BROWSER_NAVIGATION_TIMEOUT_SECONDS=12
BROWSER_POST_LOAD_WAIT_MS=1200
BROWSER_ARTIFACT_DIR=./browser_artifacts
EVIDENCE_ARTIFACT_DIR=./evidence_artifacts
JOB_WORKER_COUNT=2
JOB_POLL_INTERVAL_SECONDS=0.5
JOB_DEFAULT_TIMEOUT_SECONDS=300
JOB_DEFAULT_MAX_ATTEMPTS=2
JOB_LEASE_SECONDS=45
JOB_HEARTBEAT_SECONDS=10
JOB_EMBEDDED_WORKERS=0
JOB_IMMEDIATE_ACCELERATOR=true
RESTORE_PENDING_DIR=./restore_pending
